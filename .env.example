# Production (.env.prod yoki server environment)
SECRET_KEY=change-me-long-random-string
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

POSTGRES_DB=oshxona
POSTGRES_USER=oshxona
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/1
SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO

# Mahsulot avto-to‘ldirish (ixtiyoriy). Gemini birinchi tanlanadi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ERP Isomerix — prixod + qarz to‘lov sync (ixtiyoriy; bo‘sh bo‘lsa yuborilmaydi)
# ERP_ISOMERIX_WEBHOOK_URL=https://erp-isomerix.uz/accounting/api/integrations/chefpro/kitchen-expense/
# ERP_ISOMERIX_PAYMENT_WEBHOOK_URL=https://erp-isomerix.uz/accounting/api/integrations/chefpro/kitchen-payment/
# (PAYMENT URL bo‘sh bo‘lsa expense URL ishlatiladi — event=payment.*)
